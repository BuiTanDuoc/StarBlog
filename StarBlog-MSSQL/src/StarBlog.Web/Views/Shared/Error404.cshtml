@{
    ViewData["Title"] = "Không tìm thấy trang - Lỗi 404";
    ViewData["SeoMetadata"] = new StarBlog.Web.Services.SeoMetadata {
        Title = "Không tìm thấy trang - Lỗi 404 - StarBlog",
        Description = "Xin lỗi, trang bạn truy cập không tồn tại. Vui lòng kiểm tra URL có đúng không, hoặc về trang chủ để xem nội dung khác.",
        Keywords = "404,Không tìm thấy trang, lỗi,StarBlog",
        OgTitle = "Không tìm thấy trang - StarBlog",
        OgDescription = "Xin lỗi, trang bạn truy cập không tồn tại.",
        OgType = "website",
        TwitterCard = "summary",
        TwitterTitle = "Không tìm thấy trang - StarBlog",
        TwitterDescription = "Xin lỗi, trang bạn truy cập không tồn tại."
    };
}


@section head {
    <style>
        .error-page {
            padding: 2rem 0;
        }

        .display-1 {
            font-size: 8rem;
            line-height: 1;
        }

        @@media (max-width: 768px) {
            .display-1 {
                font-size: 6rem;
            }
        }
    </style>
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 text-center">
            <div class="error-page">
                <h1 class="display-1 fw-bold text-primary">404</h1>
                <h2 class="mb-4">Không tìm thấy trang</h2>
                <p class="lead mb-4">
                    Xin lỗi, trang bạn truy cập không tồn tại hoặc đã bị di chuyển.
                </p>
                <p class="mb-4">
                    Các nguyên nhân có thể:
                </p>
                <ul class="list-unstyled mb-4">
                    <li>• Nhập sai địa chỉ URL</li>
                    <li>• Trang đã bị xóa hoặc di chuyển</li>
                    <li>• Liên kết đã hết hạn</li>
                </ul>

                <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center">
                    <a href="/" class="btn btn-primary btn-lg">
                        <i class="fas fa-home me-2"></i>Về trang chủ
                    </a>
                    <a href="/Blog/List" class="btn btn-outline-primary btn-lg">
                        <i class="fas fa-blog me-2"></i>Xem blog
                    </a>
                    <a href="/Search" class="btn btn-outline-secondary btn-lg">
                        <i class="fas fa-search me-2"></i>Tìm kiếm nội dung
                    </a>
                </div>

                <hr class="my-5">

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <h5>Bài viết phổ biến</h5>
                        <div class="list-group list-group-flush">
                            <a href="/Blog/List" class="list-group-item list-group-item-action">
                                Xem tất cả bài viết
                            </a>
                        </div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <h5>Điều hướng danh mục</h5>
                        <div class="list-group list-group-flush">
                            <a href="/Blog/List" class="list-group-item list-group-item-action">
                                Danh mục kỹ thuật
                            </a>
                        </div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <h5>Các trang khác</h5>
                        <div class="list-group list-group-flush">
                            <a href="/About" class="list-group-item list-group-item-action">
                                Về chúng tôi
                            </a>
                            <a href="/Photography" class="list-group-item list-group-item-action">
                                Tác phẩm nhiếp ảnh
                            </a>
                            <a href="/LinkExchange" class="list-group-item list-group-item-action">
                                Liên kết bạn bè
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

