@model StarBlog.Web.ViewModels.PostViewModel
@{
    ViewData["Title"] = "Kiểm thử thẻ Meta";
}

<div class="container py-5">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <h1 class="mb-4">Kiểm thử thẻ Meta</h1>
            
            <div class="alert alert-info">
                <h5>Giải thích thẻ Meta</h5>
                <p>Trang này hiển thị các thẻ meta SEO và dữ liệu có cấu trúc được tạo cho trang bài viết.</p>
            </div>

            @if (ViewBag.Error != null) {
                <div class="alert alert-danger">
                    @ViewBag.Error
                </div>
            } else if (Model != null) {
                <div class="card mb-4">
                    <div class="card-header">
                        <h5>Thông tin bài viết thử nghiệm</h5>
                    </div>
                    <div class="card-body">
                        <h6>@Model.Title</h6>
                        <p class="text-muted">@Model.Summary</p>
                        <small>
                            Thời gian xuất bản: @Model.CreationTime.ToString("yyyy-MM-dd HH:mm")
                            @if (Model.Category != null) {
                                <span class="ms-3">Danh mục: @Model.Category.Name</span>
                            }
                        </small>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header">
                        <h5>Các thẻ Meta đã tạo</h5>
                    </div>
                    <div class="card-body">
                        <p class="text-muted">Dưới đây là các thẻ meta được tạo cho trang này (xem mã nguồn trang để thấy hiệu quả thực tế):</p>
                        <div class="bg-light p-3 rounded">
                            <small>
                                @if (ViewData["SeoMetadata"] is StarBlog.Web.Services.SeoMetadata seoMeta) {
                                    <div>&lt;title&gt;@seoMeta.Title&lt;/title&gt;</div>
                                    <div>&lt;meta name="description" content="@seoMeta.Description"&gt;</div>
                                    <div>&lt;meta name="keywords" content="@seoMeta.Keywords"&gt;</div>
                                    <div>&lt;meta property="og:title" content="@seoMeta.OgTitle"&gt;</div>
                                    <div>&lt;meta property="og:description" content="@seoMeta.OgDescription"&gt;</div>
                                    <div>&lt;meta property="og:type" content="@seoMeta.OgType"&gt;</div>
                                    <div>&lt;meta name="twitter:card" content="@seoMeta.TwitterCard"&gt;</div>
                                    <div>&lt;meta name="twitter:title" content="@seoMeta.TwitterTitle"&gt;</div>
                                }
                            </small>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        <h5>Xem trước dữ liệu có cấu trúc</h5>
                    </div>
                    <div class="card-body">
                        <p class="text-muted">Dưới đây là dữ liệu có cấu trúc JSON-LD được tạo cho trang này:</p>
                        @if (ViewData["StructuredData"] is Dictionary<string, string> structuredData) {
                            @foreach (var item in structuredData) {
                                <div class="mb-3">
                                    <h6>@item.Key</h6>
                                    <pre class="bg-light p-2 rounded small" style="max-height: 200px; overflow-y: auto;">@item.Value</pre>
                                </div>
                            }
                        }
                    </div>
                </div>
            }

            <div class="mt-4">
                <a href="/seo-test" class="btn btn-primary">Về trang chủ kiểm thử SEO</a>
            </div>
        </div>
    </div>
</div>
