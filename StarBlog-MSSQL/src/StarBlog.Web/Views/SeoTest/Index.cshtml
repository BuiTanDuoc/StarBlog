@{
    ViewData["Title"] = "Kiểm thử chức năng SEO";
}

<div class="container py-5">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <h1 class="mb-4">Kiểm thử chức năng SEO</h1>
            
            <div class="alert alert-info">
                <h5>Giải thích kiểm thử</h5>
                <p>Trang này dùng để kiểm tra xem chức năng tối ưu SEO của StarBlog có hoạt động bình thường hay không.</p>
            </div>

            <div class="card">
                <div class="card-header">
                    <h5>Kết quả kiểm thử</h5>
                </div>
                <div class="card-body">
                    @if (ViewBag.TestResults != null) {
                        <ul class="list-unstyled">
                            @foreach (string result in ViewBag.TestResults) {
                                <li class="mb-2">
                                    @if (result.StartsWith("✅")) {
                                        <span class="text-success">@result</span>
                                    } else if (result.StartsWith("❌")) {
                                        <span class="text-danger">@result</span>
                                    } else if (result.StartsWith("🎉")) {
                                        <span class="text-primary fw-bold">@result</span>
                                    } else {
                                        <span>@result</span>
                                    }
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>

            <div class="mt-4">
                <h5>Các trang kiểm thử khác</h5>
                <div class="list-group">
                    <a href="/seo-test/sitemap" class="list-group-item list-group-item-action">
                        <strong>Kiểm thử Sitemap</strong>
                        <small class="d-block text-muted">Kiểm tra chức năng tạo XML sitemap</small>
                    </a>
                    <a href="/seo-test/meta" class="list-group-item list-group-item-action">
                        <strong>Kiểm thử thẻ Meta</strong>
                        <small class="d-block text-muted">Kiểm tra thẻ meta và dữ liệu có cấu trúc của trang</small>
                    </a>
                    <a href="/sitemap.xml" class="list-group-item list-group-item-action" target="_blank">
                        <strong>Xem Sitemap chính</strong>
                        <small class="d-block text-muted">Xem sitemap.xml đã tạo trong cửa sổ mới</small>
                    </a>
                    <a href="/sitemap-images.xml" class="list-group-item list-group-item-action" target="_blank">
                        <strong>Xem Sitemap hình ảnh</strong>
                        <small class="d-block text-muted">Xem sitemap hình ảnh đã tạo trong cửa sổ mới</small>
                    </a>
                    <a href="/robots.txt" class="list-group-item list-group-item-action" target="_blank">
                        <strong>Xem Robots.txt</strong>
                        <small class="d-block text-muted">Xem tệp robots.txt trong cửa sổ mới</small>
                    </a>
                </div>
            </div>

            <div class="mt-4">
                <h5>Danh sách kiểm tra SEO</h5>
                <div class="row">
                    <div class="col-md-6">
                        <h6>SEO kỹ thuật</h6>
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item">✅ XML Sitemap</li>
                            <li class="list-group-item">✅ Sitemap hình ảnh</li>
                            <li class="list-group-item">✅ Robots.txt</li>
                            <li class="list-group-item">✅ Thiết kế responsive</li>
                            <li class="list-group-item">✅ Nén trang</li>
                            <li class="list-group-item">✅ Chiến lược cache</li>
                        </ul>
                    </div>
                    <div class="col-md-6">
                        <h6>SEO nội dung</h6>
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item">✅ Tối ưu tiêu đề trang</li>
                            <li class="list-group-item">✅ Mô tả Meta</li>
                            <li class="list-group-item">✅ Dữ liệu có cấu trúc</li>
                            <li class="list-group-item">✅ Open Graph tag</li>
                            <li class="list-group-item">✅ Twitter Card</li>
                            <li class="list-group-item">✅ Thuộc tính Alt của hình ảnh</li>
                            <li class="list-group-item">✅ Xây dựng liên kết nội bộ</li>
                            <li class="list-group-item">✅ Breadcrumb (điều hướng)</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
