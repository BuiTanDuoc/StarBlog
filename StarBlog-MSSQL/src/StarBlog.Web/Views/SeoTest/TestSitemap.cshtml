@{
    ViewData["Title"] = "Kiểm thử Sitemap";
}

<div class="container py-5">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <h1 class="mb-4">Kiểm thử Sitemap</h1>
            
            <div class="alert alert-info">
                <h5>Giải thích về Sitemap</h5>
                <p>Sitemap giúp công cụ tìm kiếm phát hiện và lập chỉ mục nội dung website tốt hơn.</p>
            </div>

            <div class="card">
                <div class="card-header">
                    <h5>Các Sitemap khả dụng</h5>
                </div>
                <div class="card-body">
                    @if (ViewBag.SitemapUrls != null) {
                        <div class="list-group">
                            @foreach (string url in ViewBag.SitemapUrls) {
                                <a href="@url" class="list-group-item list-group-item-action" target="_blank">
                                    <strong>@url</strong>
                                    <small class="d-block text-muted">
                                        @switch (url) {
                                            case "/sitemap.xml":
                                                @:XML sitemap chính, bao gồm tất cả các trang
                                                break;
                                            case "/sitemap-images.xml":
                                                @:Sitemap hình ảnh, bao gồm hình ảnh trong tất cả bài viết
                                                break;
                                            case "/sitemap-index.xml":
                                                @:Tệp chỉ mục Sitemap, liệt kê tất cả sitemap
                                                break;
                                        }
                                    </small>
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="mt-4">
                <h5>Công cụ xác thực Sitemap</h5>
                <p>Bạn có thể dùng các công cụ sau để xác thực tính hợp lệ của sitemap:</p>
                <ul>
                    <li><a href="https://www.google.com/webmasters/tools/sitemap-list" target="_blank">Google Search Console</a></li>
                    <li><a href="https://www.bing.com/webmaster" target="_blank">Bing Webmaster Tools</a></li>
                    <li><a href="https://www.xml-sitemaps.com/validate-xml-sitemap.html" target="_blank">XML Sitemap Validator</a></li>
                </ul>
            </div>

            <div class="mt-4">
                <a href="/seo-test" class="btn btn-primary">Về trang chủ kiểm thử SEO</a>
            </div>
        </div>
    </div>
</div>
