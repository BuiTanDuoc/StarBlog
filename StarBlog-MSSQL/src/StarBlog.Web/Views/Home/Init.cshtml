@model InitViewModel
@{
    ViewData["Title"] = "Init";
}

<div class="container px-4 py-3">
    <h2 class="d-flex w-100 justify-content-between pb-2 mb-3 border-bottom">
        <div>Blog Init</div>
        <div>Khởi tạo hệ thống</div>
    </h2>

    <div class="card px-1">
        <form enctype="multipart/form-data" class="card-body row" asp-controller="Home" asp-action="Init" method="post">
            <div class="text-danger" asp-validation-summary="All"></div>

            <div class="col-xl-6 py-3">
                <h5 class="card-title">Tạo tài khoản quản trị viên</h5>
                <h6 class="card-subtitle mb-3 text-muted">Dùng để đăng nhập trang quản trị</h6>
                <div class="mb-3">
                    <label asp-for="Username" class="form-label"></label>
                    <input asp-for="Username" class="form-control" aria-describedby="usernameHelp">
                    <div class="form-text">Đặt một tên người dùng cho quản trị viên dùng</div>
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" aria-describedby="passwordHelp">
                    <div class="form-text">Phải có mật khẩu mới đăng nhập được</div>
                </div>
            </div>

            <div class="col-xl-6 py-3">
                <h5 class="card-title">Cấu hình hệ thống</h5>
                <h6 class="card-subtitle mb-3 text-muted">Một số cấu hình khởi tạo</h6>
                <div class="mb-3">
                    <label asp-for="Host" class="form-label"></label>
                    <input asp-for="Host" class="form-control" aria-describedby="hostHelp">
                    <div class="form-text">Đặt tiền tố liên kết, sau này có thể sửa trong trang quản trị</div>
                </div>
                <div class="mb-3">
                    <label asp-for="DefaultRender" class="form-label"></label>
                    <select asp-for="DefaultRender" class="form-select">
                        <option value="frontend" selected>Render ở frontend</option>
                        <option value="backend">Render ở backend (Alpha)</option>
                    </select>
                    <span asp-validation-for="DefaultRender" class="form-text text-danger"></span>
                    <div class="form-text">
                        Thiết lập cách render bài viết blog, render ở frontend dùng Editor.md, render ở backend cho kết quả nhất quán hơn.<br>
                        Xem sự khác biệt cụ thể tại <a href="https://www.cnblogs.com/deali/p/16834452.html" target="_blank">bài viết này</a>.
                        Sau khi thiết lập có thể sửa trong trang quản trị
                    </div>
                </div>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-outline-primary">Gửi</button>
                <button type="reset" class="btn btn-outline-warning">Đặt lại</button>
            </div>
        </form>
    </div>


</div>