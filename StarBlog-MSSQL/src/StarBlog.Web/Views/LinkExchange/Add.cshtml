@model StarBlog.Web.ViewModels.LinkExchange.LinkExchangeAddViewModel
@{
    ViewData["Title"] = "Đăng ký liên kết bạn bè";
}


<div class="container px-4 py-3">
    <h2 class="d-flex w-100 justify-content-between pb-2 mb-3 border-bottom">
        <div>Đăng ký liên kết bạn bè</div>
        <div>Link Exchange</div>
    </h2>

    <div class="card px-1 py-3">
        <form enctype="multipart/form-data" class="card-body row" asp-controller="LinkExchange" asp-action="Add" method="post">
            <div class="col-xl-6">
                <div class="mb-4">
                    <h4 class="card-title">Thông tin liên kết bạn bè</h4>
                    <h6 class="card-subtitle mb-3 text-muted">Vui lòng nhập thông tin website của bạn để tiện liên hệ sau này</h6>
                </div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control">
                    <span asp-validation-for="Name" class="form-text text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <input asp-for="Description" class="form-control">
                    <span asp-validation-for="Description" class="form-text text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Url" class="form-label"></label>
                    <input asp-for="Url" class="form-control">
                    <span asp-validation-for="Url" class="form-text text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="WebMaster" class="form-label"></label>
                    <input asp-for="WebMaster" class="form-control">
                    <span asp-validation-for="WebMaster" class="form-text text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control">
                    <span asp-validation-for="Email" class="form-text text-danger"></span>
                </div>
            </div>

            <div class="col-xl-6">
                <div class="ms-3 mb-4">
                    <h4 class="card-title">Lưu ý</h4>
                    <h6 class="card-subtitle mb-3 text-muted">Đăng ký liên kết bạn bè cần đáp ứng các yêu cầu sau</h6>
                </div>

                <ul class="list-group list-group-flush list-group-numbered">
                    <li class="list-group-item d-flex justify-content-between align-items-start">
                        <div class="ms-2 me-auto">
                            <div class="fw-bold">Tính tương hỗ</div>
                            Vui lòng thêm liên kết của site này vào website của bạn trước, rồi mới đăng ký liên kết bạn bè
                        </div>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-start">
                        <div class="ms-2 me-auto">
                            <div class="fw-bold">Loại nội dung</div>
                            Site này ưu tiên các blog hoặc website cùng thể loại, nội dung gốc và có nội dung tương đồng
                        </div>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-start">
                        <div class="ms-2 me-auto">
                            <div class="fw-bold">SEO</div>
                            Ưu tiên website được Baidu và Google lập chỉ mục bình thường và có ảnh chụp (snapshot) gần đây
                        </div>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-start">
                        <div class="ms-2 me-auto">
                            <div class="fw-bold">Tính hợp pháp</div>
                            Website hợp pháp, không chứa nội dung vi phạm pháp luật quốc gia liên quan, không chấp nhận liên kết của các trang rác (affiliate Taobao)
                        </div>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-start">
                        <div class="ms-2 me-auto">
                            <div class="fw-bold">Tính cập nhật kịp thời</div>
                            Không chấp nhận website có rất ít nội dung gốc và lâu ngày không cập nhật
                        </div>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-start">
                        <div class="ms-2 me-auto">
                            <div class="fw-bold">Khả năng truy cập</div>
                            Nếu website của bạn không truy cập được, liên kết bạn bè sẽ tạm thời bị gỡ; nếu cần khôi phục vui lòng liên hệ quản trị viên website để xử lý
                        </div>
                    </li>
                </ul>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-outline-primary">Gửi</button>
                <button type="reset" class="btn btn-outline-warning">Đặt lại</button>
            </div>
        </form>
    </div>


</div>