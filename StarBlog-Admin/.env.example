# Tệp ví dụ cấu hình biến môi trường
# Sao chép tệp này thành .env và điền giá trị cấu hình thực tế

# URL cơ sở của API backend
BASE_URL=http://localhost:5038

# Đường dẫn trang quản trị
ASSETS_PUBLIC_PATH=/admin/

# Khóa API Exceptionless
EXCEPTION_LESS_API_KEY=your_api_key_here

# URL máy chủ Exceptionless
EXCEPTION_LESS_SERVER_URL=http://localhost:5000
